#!/bin/sh
# pre-commit：敏感内容扫描（由 opensource-guard 安装）
#
# 启用：git config core.hooksPath scripts/hooks
# 手动跑：node scripts/leakscan.mjs
# 临时跳过：git commit --no-verify（CI 仍会拦）

root=$(git rev-parse --show-toplevel) || exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: 未找到 node，跳过敏感内容扫描" >&2
  exit 0
fi

node "$root/scripts/leakscan.mjs" || exit 1
